# 单镜像跨架构联合仿真：一个容器里同时跑
#   - x86 原生 MuJoCo 仿真(GPU GUI)
#   - aarch64 控制器(QEMU 模拟，板子同款二进制)
# 二者通过容器内 loopback DDS 闭环。
#
# 难点：x86 仿真要 gcc-9 运行时(Ubuntu 20.04，匹配仓库 x86 GCC9 LTO 预编译库)，
# 而 aarch64 控制器是按板子 Ubuntu 22.04/glibc 2.35 交叉编译的 —— 两套运行时 glibc
# 版本不同。故：主镜像用 20.04(x86 仿真)，多阶段拷入一份 aarch64 22.04 运行时库
# 放 /opt/aarch64-rootfs，QEMU 用它作 LD_PREFIX 解析 aarch64 的 loader/glibc/libstdc++。

# ── Stage 1: aarch64 (Ubuntu 22.04, glibc 2.35) 运行时库 ──
FROM --platform=linux/arm64 ubuntu:22.04 AS arm64rt
RUN apt-get update && apt-get install -y --no-install-recommends \
    libstdc++6 libyaml-cpp0.7 libgcc-s1 libatomic1 \
    && rm -rf /var/lib/apt/lists/*

# ── Stage 2: x86 仿真 + aarch64 运行时 ──
FROM nvidia/opengl:1.2-glvnd-runtime-ubuntu20.04

ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=all,display
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build pkg-config git ca-certificates file \
    libeigen3-dev libyaml-cpp-dev libgtest-dev libgflags-dev \
    libglfw3-dev libgl1-mesa-dev libglu1-mesa-dev libglew-dev libosmesa6-dev \
    libx11-dev libxrandr-dev libxinerama-dev libxcursor-dev libxi-dev \
    libacl1-dev libncurses5-dev libusb-1.0-0-dev \
    qemu-user-static mesa-utils x11-apps \
    && rm -rf /var/lib/apt/lists/*

# aarch64 22.04 运行时根(glibc 2.35)，QEMU 解析 aarch64 二进制的 loader/系统库
COPY --from=arm64rt / /opt/aarch64-rootfs
ENV QEMU_LD_PREFIX=/opt/aarch64-rootfs

WORKDIR /workspace
