<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS>
    <Domain Id="any">
        <!--
            CycloneDDS 共享内存传输配置（含跨机通信）
            RouDi 随 roslaunch 自动启动
            默认绑 lo 本机通信，部署时若检测到 192.168.26.1 网口则自动切换为跨机通信
        -->
        <SharedMemory>
            <Enable>true</Enable>
            <LogLevel>error</LogLevel>
        </SharedMemory>
        <General>
            <Interfaces>
                <NetworkInterface name="lo" multicast="default" />
            </Interfaces>
            <AllowMulticast>true</AllowMulticast>
        </General>
        <Discovery>
            <!-- Multiple platform processes share domain 0. The default 0..9
                 participant range can be exhausted before the joystick starts. -->
            <ParticipantIndex>auto</ParticipantIndex>
            <MaxAutoParticipantIndex>99</MaxAutoParticipantIndex>
            <Peers><Peer address="127.0.0.1"/></Peers>
            <EnableTopicDiscoveryEndpoints>true</EnableTopicDiscoveryEndpoints>
        </Discovery>
        <!-- <Tracing> -->
            <!-- <Verbosity>config</Verbosity> -->
            <!-- <OutputFile>cdds.log.${CYCLONEDDS_PID}</OutputFile> -->
            <!-- <OutputFile>stderr</OutputFile> -->
        <!-- </Tracing> -->
    </Domain>
</CycloneDDS>
